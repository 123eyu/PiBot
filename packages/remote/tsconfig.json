{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "composite": true,
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "outDir": ".cache/tsc",
    "tsBuildInfoFile": ".cache/tsc/tsconfig.tsbuildinfo",
    "disableSourceOfProjectReferenceRedirect": true,
    "noCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/ui/**", "**/*.test.ts", "**/*.test.tsx", "test/**"],
  "references": [
    {
      "path": "../brain"
    },
    {
      "path": "../browser-contract"
    },
    {
      "path": "../execution"
    },
    {
      "path": "../i18n"
    },
    {
      "path": "../link"
    },
    {
      "path": "../protocol"
    },
    {
      "path": "../protocol-base"
    },
    {
      "path": "../remote-contract"
    },
    {
      "path": "../renderer-kit"
    },
    {
      "path": "../runner"
    },
    {
      "path": "../secrets"
    },
    {
      "path": "../storage"
    },
    {
      "path": "../ui"
    }
  ]
}
