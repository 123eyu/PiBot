{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "composite": true,
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "outDir": ".cache/tsc",
    "tsBuildInfoFile": ".cache/tsc/tsconfig.tsbuildinfo",
    "disableSourceOfProjectReferenceRedirect": true,
    "noCheck": true
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../../packages/acp"
    },
    {
      "path": "../../packages/brain-app"
    },
    {
      "path": "../../packages/execution"
    },
    {
      "path": "../../sdk/plugin-sdk"
    },
    {
      "path": "../../packages/protocol"
    },
    {
      "path": "../../packages/sdk"
    },
    {
      "path": "../../packages/storage"
    }
  ],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "test/**"]
}
