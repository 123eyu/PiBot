{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pibot-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "send_metrics": false,
  // Official relay (maintainers 2026-10-22): a subdomain of the website's zone. Self-hosters change it.
  "routes": [{ "pattern": "relay.pibot.space", "custom_domain": true }],
  // Maintainers 2026-11-17: keep full Workers Logs (request URL, headers, IP, outcome) to diagnose
  // users whose devices cannot reach the relay; Cloudflare retains them for its standard window.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // STATS: aggregate connection counts per day × role × room kind, no identifiers.
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "STATS", "class_name": "Stats" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Stats"] }
  ],
  "ratelimits": [
    {
      "name": "CONNECTION_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    },
    { "name": "PUSH_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],
  "env": {
    "memory": {
      "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
      "ratelimits": []
    }
  }
}
