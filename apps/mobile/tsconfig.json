{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["react", "react-native"],
    "composite": true,
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "outDir": ".cache/tsc",
    "tsBuildInfoFile": ".cache/tsc/tsconfig.tsbuildinfo",
    "disableSourceOfProjectReferenceRedirect": true,
    "noCheck": true
  },
  "include": [
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "modules/**/*.ts",
    "plugins/**/*.ts",
    "index.ts",
    "app.config.ts"
  ],
  "references": [
    {
      "path": "../../packages/agent"
    },
    {
      "path": "../../packages/client-core"
    },
    {
      "path": "../../packages/i18n"
    },
    {
      "path": "../../packages/link"
    },
    {
      "path": "../../packages/policy"
    },
    {
      "path": "../../packages/protocol"
    },
    {
      "path": "../../packages/protocol-base"
    },
    {
      "path": "../../packages/ui"
    }
  ],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "test/**"]
}
